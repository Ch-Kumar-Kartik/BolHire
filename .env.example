# Frontend development server configuration
VITE_API_BASE_URL=http://localhost:8000

# Backend development server configuration
BACKEND_CORS_ORIGIN=http://localhost:5173
# Local verification only. Never enable in deployment. Only the value 1 enables it.
BOLHIRE_DEV_PROFILE_INSPECTION=0

# Database foundation is opt-in. Never put real credentials in this template.
DATABASE_ENABLED=0
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
# Candidate authentication (read only when DATABASE_ENABLED=1). Unset origin rejects every login and logout.
# AUTH_TRUSTED_ORIGIN=https://your-frontend.example.com
# AUTH_COOKIE_SECURE=1   # 0 only for an http://localhost origin; any other use fails at startup
# AUTH_TRUSTED_PROXY_HOPS=0   # leave 0 until the real forwarding chain is verified; see docs/database-development.md
# Disposable local test infrastructure; configure these only in ignored .env.test.
# TEST_POSTGRES_PASSWORD=choose-a-disposable-local-password
# TEST_DATABASE_URL=postgresql+psycopg://bolhire_test:PASSWORD@127.0.0.1:55432/bolhire_test

# Speech defaults to mock. Set these in your local environment for manual Gnani testing.
SPEECH_PROVIDER=mock
GNANI_API_KEY=your-server-side-key
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani

# Configurable estimates only, not provider billing figures.
GNANI_STT_RATE_INR_PER_HOUR=27
GNANI_TTS_RATE_INR_PER_10000_CHARACTERS=27

# Conversation defaults to mock independently of speech mode.
LLM_PROVIDER=mock
GEMINI_API_KEY=your-server-side-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_THINKING_LEVEL=minimal
# For Gemini 2.5 Flash only, remove GEMINI_THINKING_LEVEL and use GEMINI_THINKING_BUDGET=0.
# Optional: GEMINI_SYSTEM_PROMPT=Your short voice-friendly assistant instruction.
